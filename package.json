{
  "name": "@astrosheep/pi-copy",
  "version": "0.1.0",
  "repository": { "type": "git", "url": "git+https://github.com/astrosheep-zero/pi-copy.git" },
  "description": "Copy assistant output with /cp: response, code, sections, and table cells",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:load": "pi --no-extensions -e ./src/index.ts --list-models __load_check__"
  },
  "dependencies": {
    "marked": "18.0.14"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  }
}
